# Differential source manifests hash exact checkout bytes on every platform.
*.go text eol=lf
*.py text eol=lf
/testdata/rust-port/*-cases.json text eol=lf
/testdata/rust-port/fixtures/*-differential-*.json text eol=lf
/Cargo.toml text eol=lf
/Cargo.lock text eol=lf
/rust-toolchain.toml text eol=lf
/.github/workflows/ci.yml text eol=lf
/.cargo/** text eol=lf
/rust/**/*.rs text eol=lf
/rust/**/Cargo.toml text eol=lf
/scripts/rust-port/sqlite/** text eol=lf
/testdata/rust-port/sqlite/*.json text eol=lf
/assets/branding/SymairaCoreKit/** -text
/llmkit/providers.json text eol=lf
/llmkit/*.go text eol=lf
/secretref/*.go text eol=lf
/exitcodes/*.go text eol=lf
/updatecheck/*.go text eol=lf
/scripts/rust-port/update-oracle/main.go text eol=lf
/scripts/rust-port/update-version-differential.py text eol=lf
/scripts/rust-port/update-response-oracle/main.go text eol=lf
/scripts/rust-port/update-response-differential.py text eol=lf
/scripts/rust-port/llm-oracle/main.go text eol=lf
/scripts/rust-port/llm-differential.py text eol=lf
/.gitattributes text eol=lf
# Retain exact native CI artifact bytes, including producer CRLF.
/docs/rust-port/evidence/update-native-20261002/** -text whitespace=cr-at-eol
# Historical fixture digests are also exact-byte anchors, not normalized JSON.
/testdata/rust-port/fixtures/update/*.json -text whitespace=cr-at-eol
/testdata/rust-port/fixtures/update/static-v1/** -text whitespace=cr-at-eol
/testdata/rust-port/fixtures/update/static-v2/** -text whitespace=cr-at-eol
/testdata/rust-port/fixtures/fs-secret/frozen-v1/** -text whitespace=cr-at-eol
/testdata/rust-port/sqlite/frozen-v1/** -text whitespace=cr-at-eol
# Frozen Foundation/LLM hashes bind original JSON bytes on every checkout,
# including ordinary Windows CI jobs that inherit core.autocrlf=true.
/contracts/*.json -text
/testdata/rust-port/fixtures/foundation/** -text
/testdata/rust-port/fixtures/contracts/** -text
/testdata/rust-port/fixtures/llm/** -text
/rust/test-support/symaira-contract-fixtures/fixtures/foundation/** -text
/rust/test-support/symaira-contract-fixtures/fixtures/contracts/** -text
