{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "project": "symaira-appkit",
  "tokens": {
    "bg": "#0d0c0a",
    "bg-darker": "#070605",
    "fg": "#f5f4f0",
    "muted": "#b5aea5",
    "muted-readable": "#837d74",
    "surface": "rgba(18,17,14,.72)",
    "surface-opaque": "#171510",
    "surface-hover": "#211f1a",
    "accent": "#e5c397",
    "accent-on": "#211d17",
    "accent-secondary": "#f8e6cd",
    "positive": "#7fd49a",
    "warning": "#e9bc73",
    "critical": "#ff8a80",
    "informative": "#8cc8f2",
    "border": "rgba(255,255,255,.08)",
    "border-hover": "rgba(229,195,151,.24)",
    "font-display": "system-ui,-apple-system,sans-serif",
    "font-body": "system-ui,-apple-system,sans-serif",
    "font-mono": "ui-monospace,SFMono-Regular,Menlo,monospace",
    "space-xs": "4px",
    "space-sm": "8px",
    "space-md": "12px",
    "space-lg": "16px",
    "space-xl": "24px",
    "space-section": "32px",
    "space-spacious": "48px",
    "radius-control": "10px",
    "radius-card": "12px",
    "radius-panel": "16px",
    "motion-fast": "160ms"
  }
}
