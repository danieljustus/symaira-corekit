{
  "schema_version": 2,
  "purpose": "Repeatable paired-consumer canaries for RUST-005; all binaries are built from exact local pre-adoption and adoption commits.",
  "runs": {"startup_and_operation": 50, "clean_and_warm_build": 10},
  "consumers": [
    {
      "repository": "danieljustus/symaira-vault",
      "snapshot_commit": "772165a2b3a8efc6aebed7f904f38edeac45458a",
      "pre_adoption_commit": "555f7c6f24af9acf29fd8a68d582702166d3e40b",
      "adoption_commit": "772165a2b3a8efc6aebed7f904f38edeac45458a",
      "capability": "version --json",
      "tool": "symvault",
      "version_argv": ["version", "--json"],
      "go_build": "CGO_ENABLED=0 GOTOOLCHAIN=local go build -trimpath -o <artifact> .",
      "go_run": "<artifact> version --json",
      "rust_build": "CARGO_TARGET_DIR=<benchmark-target> cargo build --release --locked --bin symvault",
      "rust_run": "<artifact> version --json",
      "rust_binary": "symvault",
      "metrics": ["binary_size_bytes", "startup_p95_ms", "peak_rss_median_bytes", "clean_build_ms", "warm_build_ms"]
    },
    {
      "repository": "danieljustus/symaira-eraseme",
      "snapshot_commit": "27a3f790c59771e53636fa9b6b13e5687c689f3a",
      "pre_adoption_commit": "c5ea58d32ab71b342bb7e4aa430e13dd28deca49",
      "adoption_commit": "27a3f790c59771e53636fa9b6b13e5687c689f3a",
      "capability": "version --json",
      "tool": "symeraseme",
      "version_argv": ["version", "--json"],
      "go_build": "CGO_ENABLED=0 GOTOOLCHAIN=local go build -trimpath -o <artifact> ./cmd/symeraseme",
      "go_ldflags": "-X main.versionValue=0.13.0",
      "go_run": "<artifact> version --json",
      "rust_build": "CARGO_TARGET_DIR=<benchmark-target> cargo build --release --locked --bin symeraseme-rust",
      "rust_run": "<artifact> version --json",
      "rust_binary": "symeraseme-rust",
      "metrics": ["binary_size_bytes", "startup_p95_ms", "peak_rss_median_bytes", "clean_build_ms", "warm_build_ms"]
    }
  ]
}
