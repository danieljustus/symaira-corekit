    {
      "id": "MCFG-001-jsonc-comments-and-urls",
      "mode": "discover",
      "goos": "darwin",
      "home": "/home/u",
      "sources": [
        {
          "client": "hermes",
          "path": "/cfg/hermes/config.json",
          "key": "mcpServers"
        }
      ],
      "files": {
        "/cfg/hermes/config.json": "{\n  // a line comment with \"quotes\" and // slashes\n  /* block\n     comment */\n  \"mcpServers\": {\n    \"alpha\": {\"command\": \"npx\", \"args\": [\"-y\", \"pkg\"], \"env\": {\"TOKEN\": \"s3cret\"}},\n    \"beta\": {\"url\": \"https://example.test/mcp/*literal*//path\", \"type\": \"sse\"},\n    \"gamma\": {\"command\": \"echo \\\"hi//there\\\"\"}\n  }\n}\n"
      }
    },
